#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // ------------------------------------------------------------
        // CUSTOM BEHAVIORS
        // ------------------------------------------------------------
        behaviors {
            cs_v: ctrl_shift_v {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp LCTRL &kp LSHFT &kp V>;
            };
        };

        // ------------------------------------------------------------
        // BASE LAYER
        // ------------------------------------------------------------
        default_layer {
            display-name = "base";

            bindings = <
                &kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5        &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T         &kp Y  &kp U  &kp I  &kp O  &kp P  &kp DEL
                &kp TAB   &kp A  &kp S  &kp D  &kp F  &kp G         &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B         &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &kp LCTRL &kp LALT &kp LGUI &mo RAISE &kp RET       &kp SPACE &mo RAISE &kp MINUS &kp LBKT &kp RBKT
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN
                &inc_dec_kp C_SCROLL_UP C_SCROLL_DOWN
                &kp LG(N0)
            >;
        };

        // ------------------------------------------------------------
        // RAISE LAYER
        // ------------------------------------------------------------
        raise_layer {
            display-name = "raise";

            // Rules:
            // W = UP
            // A S D = LEFT DOWN RIGHT
            // E = =
            // V = GUI + SHIFT + V
            // ESC (in raise) = `
            // / (in raise) = \
            // everything else transparent

            bindings = <
                // Row 1 (F-row + ESC = `)
                &kp GRAVE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5        &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11

                // Row 2 (W = UP, E = =)
                &trans &trans &kp UP &kp EQUAL &trans &trans        &trans &trans &trans &trans &trans &kp F12

                // Row 3 (A S D = arrows)
                &trans &kp LEFT &kp DOWN &kp RIGHT &trans &trans     &trans &trans &trans &trans &trans &trans

                // Row 4 (/ position = \, V = Ctrl+Shift+V)
                &trans &trans &trans &trans &cs_v &trans            &trans &trans &trans &trans &kp BSLH &trans

                // Thumb cluster (transparent)
                &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <
                &inc_dec_kp C_SCROLL_UP C_SCROLL_DOWN
                &none
                &kp LG(N0)
            >;
        };
    };
};
