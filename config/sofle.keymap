#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    behaviors {
        cs_v: ctrl_shift_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LGUI &kp LSHFT>,
                <&macro_tap &kp V>,
                <&macro_release &kp LSHFT &kp LGUI>;
        };

        zoom_reset: zoom_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LGUI>,
                <&macro_tap &kp N0>,
                <&macro_release &kp LGUI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ------------------------------------------------------------
        // BASE LAYER
        // ------------------------------------------------------------
        default_layer {
            display-name = "base";

            bindings = <
                &kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5        &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T         &kp Y  &kp U  &kp I  &kp O  &kp P  &kp DEL
                &kp TAB   &kp A  &kp S  &kp D  &kp F  &kp G         &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &zoom_reset  &kp C_MUTE  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &kp LCTRL &kp LALT &kp LGUI &mo 1 &kp RET       &kp SPACE &mo 1 &kp MINUS &kp LBKT &kp RBKT
            >;

            sensor-bindings = <
                &inc_dec_kp LG(EQUAL) LG(MINUS)
                &inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP 
            >;
        };

        // ------------------------------------------------------------
        // RAISE LAYER
        // ------------------------------------------------------------
        raise_layer {
            display-name = "raise";

            bindings = <
                &kp GRAVE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5        &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &trans
                &trans &trans &kp UP &kp EQUAL &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &kp LEFT &kp DOWN &kp RIGHT &trans &trans      &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &cs_v &trans  &trans  &trans  &trans &trans &trans &trans &kp BSLH &trans
                &trans &trans &trans &trans &trans                     &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <
                &inc_dec_kp LG(EQUAL) LG(MINUS)
                &inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP
            >;
        };
    };
};
