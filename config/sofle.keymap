#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define RAISE 1

&led_strip {
    chain-length = <36>;
};

&nice_view_spi {
    cs-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // | ESC | 1 | 2 | 3 | 4 | 5 |                 | 6 | 7 | 8 | 9 | 0 | BSPC |
            // | TAB | Q | W | E | R | T |                 | Y | U | I | O | P | DEL  |
            // | TAB | A | S | D | F | G |                 | H | J | K | L | ; | '    |
            // | SHF | Z | X | C | V | B | MUTE | |      | N | M | , | . | / | SHF  |
            //        | CTRL | ALT | GUI | RAISE | ENTER | SPACE | RAISE | - | [ | ] |

            bindings = <
                &kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T                  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp DEL
                &kp TAB   &kp A  &kp S  &kp D  &kp F  &kp G                  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B   &kp C_MUTE &none &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &kp LCTRL &kp LALT &kp LGUI &mo RAISE &kp RET    &kp SPACE &mo RAISE &kp MINUS &kp LBKT &kp RBKT
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN &none
                &inc_dec_kp C_SCROLL_UP C_SCROLL_DOWN &kp LG(N0)
            >;
        };

        raise_layer {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | TRNS | F1 | F2 | F3 | F4 | F5 |               | F6 | F7 | F8 | F9 | F10 | F11 |
            // | TRNS | TRNS | UP | = | TRNS | TRNS |          | TRNS | TRNS | TRNS | TRNS | TRNS | F12 |
            // | TRNS | LEFT | DOWN | RIGHT | TRNS | TRNS |    | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS |
            // | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS |      | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS |
            //              | TRNS | TRNS | TRNS | TRNS | GUI+SHIFT+V | TRNS | TRNS | TRNS | TRNS | TRNS |

            bindings = <
                // F-row
                &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5           &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11

                // numbers row
                &trans &trans &kp UP &kp EQUAL &trans &trans       &trans &trans &trans &trans &trans &kp F12

                // home row arrows
                &trans &kp LEFT &kp DOWN &kp RIGHT &trans &trans   &trans &trans &trans &trans &trans &trans

                // lower rows transparent
                &trans &trans &trans &trans &trans &trans          &trans &trans &trans &trans &trans &trans

                // thumbs (V = GUI+SHIFT+V)
                &trans &trans &trans &trans &kp LC(LS(V))          &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <
                &inc_dec_kp C_SCROLL_UP C_SCROLL_DOWN
                &none &kp LG(N0)
            >;
        };
    };
};
